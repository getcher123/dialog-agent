# Private local settings. Never put any of these secrets into web/config.js.
OPENAI_API_KEY=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=
RAG_MAX_COMPLETION_TOKENS=1000
# Local diagnostic logs only; never exposes scores through the public API.
RAG_TRACE=false
PILOT_TOKEN=
CHAT_ENABLED=false
ALLOWED_ORIGINS=https://getcher123.github.io
# Only actual proxy IPs/CIDRs, never blanket trust of client headers.
TRUSTED_PROXY_CIDRS=
PORT=3310
